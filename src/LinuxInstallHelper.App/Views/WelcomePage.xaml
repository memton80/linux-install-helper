<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinuxInstallHelper.App.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <Grid Style="{StaticResource PageContentHostStyle}">
            <StackPanel Style="{StaticResource PageContentStackStyle}">
                <StackPanel Style="{StaticResource PageHeaderStackStyle}">
                    <TextBlock x:Uid="WelcomeHeader" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Uid="WelcomeSubtitle" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- One click is the answer: no "Next" button. -->
                <Grid Style="{StaticResource WelcomeChoicesGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="WelcomeWithHelper" Style="{StaticResource WelcomeChoiceButtonStyle}" Command="{x:Bind ViewModel.ChooseWithHelperCommand}">
                        <StackPanel Style="{StaticResource CardStackStyle}">
                            <FontIcon Style="{StaticResource WelcomeChoiceIconStyle}" Glyph="&#xE716;" />
                            <TextBlock x:Uid="WelcomeWithHelperTitle" Style="{StaticResource TourTitleStyle}" />
                            <TextBlock x:Uid="WelcomeWithHelperText" Style="{StaticResource BodyWrapTextStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="WelcomeAlone" Grid.Column="1" Style="{StaticResource WelcomeChoiceButtonStyle}" Command="{x:Bind ViewModel.ChooseAloneCommand}">
                        <StackPanel Style="{StaticResource CardStackStyle}">
                            <FontIcon Style="{StaticResource WelcomeChoiceIconStyle}" Glyph="&#xE77B;" />
                            <TextBlock x:Uid="WelcomeAloneTitle" Style="{StaticResource TourTitleStyle}" />
                            <TextBlock x:Uid="WelcomeAloneText" Style="{StaticResource BodyWrapTextStyle}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
