  <data name="Ready_Processor_Arm64_Message" xml:space="preserve">
    <value>This computer has an ARM processor (Snapdragon…). The distributions offered here are made for Intel and AMD processors (x86_64): a drive made with them starts on another computer, not on this one.</value>
  </data>
  <data name="Ready_Processor_Arm64Ok_Title" xml:space="preserve">
