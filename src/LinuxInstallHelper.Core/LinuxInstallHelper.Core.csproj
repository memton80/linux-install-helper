<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LinuxInstallHelper.Core</RootNamespace>
    <AssemblyName>LinuxInstallHelper.Core</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NJsonSchema" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <!-- The versioned catalog is embedded as the offline fallback. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\catalog\distros.json" LogicalName="catalog/distros.json" />
    <EmbeddedResource Include="..\..\catalog\distros.schema.json" LogicalName="catalog/distros.schema.json" />
    <EmbeddedResource Include="..\..\catalog\keys\*.asc" LogicalName="catalog/keys/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The lessons shown while a drive is created; their pictures are copied by the application. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\tour\tours.json" LogicalName="tour/tours.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LinuxInstallHelper.Core.Tests" />
  </ItemGroup>

</Project>
