<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinuxInstallHelper.App.Views.AdvisorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LinuxInstallHelper.App.ViewModels"
    xmlns:helpers="using:LinuxInstallHelper.App.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="AdvisorResultTemplate" x:DataType="vm:AdvisorResultViewModel">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Style="{StaticResource CardStackStyle}">
                    <Grid Style="{StaticResource DistroCardHeaderGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource BadgeBorderStyle}" Background="{x:Bind Item.BadgeBrush}">
                            <TextBlock Style="{StaticResource BadgeTextStyle}" Text="{x:Bind Item.Monogram}" />
                        </Border>
                        <StackPanel Grid.Column="1" Style="{StaticResource AdvisorNameStackStyle}">
                            <TextBlock Style="{StaticResource TourTitleStyle}" Text="{x:Bind Item.Name}" />
                            <TextBlock Style="{StaticResource DistroDetailsStyle}" Text="{x:Bind Item.Subtitle}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource BodyWrapTextStyle}" Text="{x:Bind Explanation}" />
                    <ItemsControl ItemsSource="{x:Bind Reasons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Style="{StaticResource AdvisorReasonPanelStyle}">
                                    <FontIcon Style="{StaticResource AdvisorReasonIconStyle}" Glyph="&#xE73E;" />
                                    <TextBlock Style="{StaticResource BodyWrapTextStyle}" Text="{x:Bind}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Requirements}" Visibility="{x:Bind helpers:Ui.VisibleIfText(Requirements)}" />
                    <StackPanel Style="{StaticResource IconTextPanelStyle}" Visibility="{x:Bind helpers:Ui.Visible(Item.ShowSecureBootWarning)}">
                        <FontIcon Style="{StaticResource WarningIconStyle}" Glyph="&#xE7BA;" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Item.SecureBootWarning}" />
                    </StackPanel>
                    <Button Style="{StaticResource AccentButtonStyle}" Content="{x:Bind ChooseLabel}" Command="{x:Bind ChooseCommand}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer x:Name="PageScroll" Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageContentStackStyle}">
            <StackPanel Style="{StaticResource PageHeaderStackStyle}">
                <TextBlock x:Uid="AdvisorHeader" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Uid="AdvisorSubtitle" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Questions}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.ShowQuestions), Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Style="{StaticResource GuideLessonsPanelStyle}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AdvisorQuestionViewModel">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Style="{StaticResource CompactStackStyle}">
                                <Grid Style="{StaticResource AdvisorQuestionHeaderGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource AdvisorQuestionTitleStyle}" Text="{x:Bind Title}" />
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource AdvisorWordsButtonStyle}"
                                        AutomationProperties.Name="{x:Bind WordsLabel}"
                                        ToolTipService.ToolTip="{x:Bind WordsLabel}"
                                        Visibility="{x:Bind helpers:Ui.Visible(HasWords)}">
                                        <FontIcon Style="{StaticResource AdvisorWordsIconStyle}" Glyph="&#xE9CE;" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Style="{StaticResource AdvisorWordsPanelStyle}">
                                                    <TextBlock Style="{StaticResource TourHeaderStyle}" Text="{x:Bind WordsTitle}" />
                                                    <ItemsControl ItemsSource="{x:Bind Words}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Style="{StaticResource AdvisorWordsListStyle}" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:AdvisorWord">
                                                                <StackPanel Style="{StaticResource CompactStackStyle}">
                                                                    <TextBlock Style="{StaticResource TourLabelStyle}" Text="{x:Bind Word}" />
                                                                    <TextBlock Style="{StaticResource BodyWrapTextStyle}" Text="{x:Bind Meaning}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Hint}" Visibility="{x:Bind helpers:Ui.VisibleIfText(Hint)}" />
                                <RadioButtons ItemsSource="{x:Bind Options}" SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Style="{StaticResource ButtonRowStyle}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.ShowQuestions), Mode=OneWay}">
                <Button x:Uid="AdvisorRecommend" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RecommendCommand}" />
                <HyperlinkButton x:Uid="AdvisorAllDistros" Command="{x:Bind ViewModel.ShowAllDistrosCommand}" />
                <ProgressRing Style="{StaticResource StageRingStyle}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.IsLoading), Mode=OneWay}" />
            </StackPanel>

            <StackPanel x:Name="ResultsPanel" Style="{StaticResource PageContentInnerStackStyle}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.HasResult), Mode=OneWay}">
                <Grid Style="{StaticResource TourHeaderGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="AdvisorBestTitle" Style="{StaticResource SectionTitleStyle}" />
                    <Button x:Uid="AdvisorEdit" Grid.Column="1" Command="{x:Bind ViewModel.EditAnswersCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Best}" ItemTemplate="{StaticResource AdvisorResultTemplate}" />
                <TextBlock x:Uid="AdvisorOthersTitle" Style="{StaticResource SectionTitleStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Alternatives}" ItemTemplate="{StaticResource AdvisorResultTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Style="{StaticResource GuideLessonsPanelStyle}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <HyperlinkButton x:Uid="AdvisorAllDistrosResults" Command="{x:Bind ViewModel.ShowAllDistrosCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
