<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinuxInstallHelper.App.Views.DonePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:LinuxInstallHelper.App.Helpers"
    xmlns:views="using:LinuxInstallHelper.App.Views"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <Grid Style="{StaticResource PageContentHostStyle}">
            <StackPanel Style="{StaticResource PageContentStackStyle}">
                <FontIcon Glyph="&#xE930;" Style="{StaticResource HeroIconStyle}" />
                <StackPanel Style="{StaticResource PageHeaderStackStyle}">
                    <TextBlock x:Uid="DoneHeader" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
                </StackPanel>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Style="{StaticResource CardStackStyle}">
                        <Grid Style="{StaticResource IconTextGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8FB;" Style="{StaticResource IconTextIconStyle}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" Text="{x:Bind ViewModel.Signature, Mode=OneWay}" Visibility="{x:Bind helpers:Ui.Visible(Advanced.IsOn), Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" Text="{x:Bind ViewModel.SignatureSimple, Mode=OneWay}" Visibility="{x:Bind helpers:Ui.Visible(Advanced.IsOff), Mode=OneWay}" />
                        </Grid>
                        <TextBlock Style="{StaticResource MonospaceTextStyle}" Text="{x:Bind ViewModel.Verification, Mode=OneWay}" Visibility="{x:Bind helpers:Ui.Visible(Advanced.IsOn), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource BodyWrapTextStyle}" Text="{x:Bind ViewModel.VerificationSimple, Mode=OneWay}" Visibility="{x:Bind helpers:Ui.Visible(Advanced.IsOff), Mode=OneWay}" />
                        <Grid Style="{StaticResource IconTextGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE88E;" Style="{StaticResource IconTextIconStyle}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" Text="{x:Bind ViewModel.EjectStatus, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <InfoBar x:Uid="DoneBackupReminder" IsClosable="False" Severity="Warning" IsOpen="{x:Bind ViewModel.ShowBackupReminder, Mode=OneWay}" />
                <InfoBar x:Uid="DoneSecureBoot" IsClosable="False" Severity="Warning" IsOpen="{x:Bind ViewModel.ShowSecureBootWarning, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button x:Uid="DoneOpenFirmware" Command="{x:Bind ViewModel.RestartToFirmwareCommand}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.CanRestart), Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.ShowReadiness, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.ReadinessSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.ReadinessTitle, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ReadinessMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button x:Uid="DoneOpenReadiness" Command="{x:Bind ViewModel.OpenReadinessCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Uid="Alone_DoneReadinessOk" IsClosable="False" Severity="Success" IsOpen="{x:Bind ViewModel.ShowReadinessOk, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button x:Uid="Alone_DoneOpenReadiness" Command="{x:Bind ViewModel.OpenReadinessCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Uid="DoneHiddenInWindows" IsClosable="False" Severity="Informational" IsOpen="True" />

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Style="{StaticResource CardStackStyle}">
                        <TextBlock x:Uid="DoneNextTitle" Style="{StaticResource SectionTitleStyle}" />
                        <Grid Style="{StaticResource ComponentRowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource StepNumberStyle}" Text="1" />
                            <TextBlock x:Uid="DoneStep1" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource StepNumberStyle}" Text="2" />
                            <TextBlock x:Uid="DoneStep2" Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource StepNumberStyle}" Text="3" />
                            <TextBlock x:Uid="DoneStep3" Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource StepNumberStyle}" Text="4" />
                            <TextBlock x:Uid="DoneStep4" Grid.Row="3" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource IconTextGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE765;" Style="{StaticResource IconTextIconStyle}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BootKeysTextStyle}" Text="{x:Bind ViewModel.BootKeys, Mode=OneWay}" />
                        </Grid>
                        <StackPanel Style="{StaticResource CompactStackStyle}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.CanRestart), Mode=OneWay}">
                            <TextBlock x:Uid="DoneRestartHelp" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource ButtonRowStyle}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.CanRestart), Mode=OneWay}">
                            <Button x:Uid="DoneRestartDrive" Command="{x:Bind ViewModel.RestartToDriveCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.IsAlone)}">
                    <StackPanel Style="{StaticResource CardStackStyle}">
                        <Grid Style="{StaticResource AdvisorQuestionHeaderGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="Alone_DonePlanTitle" Style="{StaticResource AdvisorQuestionTitleStyle}" />
                            <views:WordsButton Grid.Column="1" Words="{x:Bind ViewModel.PlanWords}" Label="{x:Bind ViewModel.PlanWordsLabel}" />
                        </Grid>
                        <Grid Style="{StaticResource AloneStepsGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource StepNumberStyle}" Text="1" />
                            <StackPanel Grid.Column="1" Style="{StaticResource AloneSubStepsStackStyle}">
                                <TextBlock x:Uid="Alone_DonePlan1" Style="{StaticResource BodyStrongWrapTextStyle}" />
                                <TextBlock x:Uid="Alone_DonePlan1a" Style="{StaticResource BodyWrapTextStyle}" />
                                <TextBlock x:Uid="Alone_DonePlan1b" Style="{StaticResource BodyWrapTextStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource StepNumberStyle}" Text="2" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource AloneSubStepsStackStyle}">
                                <TextBlock x:Uid="Alone_DonePlan2" Style="{StaticResource BodyStrongWrapTextStyle}" />
                                <TextBlock x:Uid="Alone_DonePlan2a" Style="{StaticResource BodyWrapTextStyle}" />
                                <TextBlock x:Uid="Alone_DonePlan2b" Style="{StaticResource BodyWrapTextStyle}" />
                                <TextBlock Style="{StaticResource BootKeysTextStyle}" Text="{x:Bind ViewModel.BootKeys, Mode=OneWay}" />
                                <TextBlock x:Uid="Alone_DonePlan2c" Style="{StaticResource BodyWrapTextStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Style="{StaticResource StepNumberStyle}" Text="3" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource AloneSubStepsStackStyle}">
                                <TextBlock x:Uid="Alone_DonePlan3" Style="{StaticResource BodyStrongWrapTextStyle}" />
                                <TextBlock x:Uid="Alone_DonePlan3a" Style="{StaticResource BodyWrapTextStyle}" />
                                <TextBlock x:Uid="Alone_DonePlan3b" Style="{StaticResource BodyWrapTextStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Style="{StaticResource StepNumberStyle}" Text="4" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Style="{StaticResource AloneSubStepsStackStyle}">
                                <TextBlock x:Uid="Alone_DonePlan4" Style="{StaticResource BodyStrongWrapTextStyle}" />
                                <TextBlock x:Uid="Alone_DonePlan4a" Style="{StaticResource BodyWrapTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Uid="Alone_DoneTryOrInstallTitle" Style="{StaticResource BodyStrongWrapTextStyle}" />
                        <Grid Style="{StaticResource IconTextGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7B3;" Style="{StaticResource IconTextIconStyle}" />
                            <TextBlock x:Uid="Alone_DoneTry" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource IconTextGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE896;" Style="{StaticResource IconTextIconStyle}" />
                            <TextBlock x:Uid="Alone_DoneInstall" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource IconTextGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE72B;" Style="{StaticResource IconTextIconStyle}" />
                            <TextBlock x:Uid="Alone_DoneBackToWindows" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                        </Grid>

                        <TextBlock x:Uid="Alone_DoneTroubleshootHelp" Style="{StaticResource SecondaryTextStyle}" />
                        <StackPanel Style="{StaticResource ButtonRowStyle}">
                            <Button x:Uid="Alone_DoneTroubleshoot" Command="{x:Bind ViewModel.OpenTroubleshootCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Style="{StaticResource ButtonRowStyle}">
                    <Button x:Uid="DoneAnother" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.CreateAnotherCommand}" />
                    <Button x:Uid="DoneGuide" Command="{x:Bind ViewModel.OpenGuideCommand}" />
                    <Button x:Uid="DoneShowIso" Command="{x:Bind ViewModel.ShowIsoCommand}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.HasIso), Mode=OneWay}" />
                    <Button x:Uid="DoneClose" Command="{x:Bind ViewModel.CloseCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
