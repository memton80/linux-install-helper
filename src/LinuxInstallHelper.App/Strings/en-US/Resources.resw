  <data name="AboutHeader.Text" xml:space="preserve">
    <value>Linux Install Helper</value>
  </data>
  <data name="About_Version" xml:space="preserve">
    <value>Version {0}</value>
  </data>
  <data name="AboutDescription.Text" xml:space="preserve">
    <value>Create a bootable USB drive of a Linux distribution in a few clicks: the official image is downloaded, verified, then written to the drive.</value>
  </data>
  <data name="AboutLicense.Text" xml:space="preserve">
    <value>Free and open source software, MIT license.</value>
  </data>
  <data name="AboutRepository.Content" xml:space="preserve">
    <value>Source code and bug reports on GitHub</value>
  </data>
  <data name="AboutSafety.Text" xml:space="preserve">
    <value>Safety</value>
  </data>
  <data name="AboutSafetyText.Text" xml:space="preserve">
    <value>Images come only from the official websites and mirrors of the distributions. Their checksum (and OpenPGP signature when published) is verified before anything is written. Only removable USB drives are offered, and the drive is checked again right before it is erased.</value>
  </data>
  <data name="AboutComponents.Text" xml:space="preserve">
    <value>Open source components</value>
  </data>
  <data name="AboutTrademarks.Text" xml:space="preserve">
    <value>Linux is a registered trademark of Linus Torvalds. Distribution names are trademarks of their respective owners. This application is not affiliated with any distribution.</value>
  </data>
