<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinuxInstallHelper.App.Views.AdvisorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LinuxInstallHelper.App.ViewModels"
    xmlns:helpers="using:LinuxInstallHelper.App.Helpers"
    xmlns:views="using:LinuxInstallHelper.App.Views"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="AdvisorResultTemplate" x:DataType="vm:AdvisorResultViewModel">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Style="{StaticResource CardStackStyle}">
                    <Grid Style="{StaticResource DistroCardHeaderGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource BadgeBorderStyle}" Background="{x:Bind Item.BadgeBrush}">
                            <TextBlock Style="{StaticResource BadgeTextStyle}" Text="{x:Bind Item.Monogram}" />
                        </Border>
                        <StackPanel Grid.Column="1" Style="{StaticResource AdvisorNameStackStyle}">
                            <TextBlock Style="{StaticResource TourTitleStyle}" Text="{x:Bind Item.Name}" />
                            <TextBlock Style="{StaticResource DistroDetailsStyle}" Text="{x:Bind Item.Subtitle}" />
                        </StackPanel>
                        <views:WordsButton Grid.Column="2" Words="{x:Bind Words}" Label="{x:Bind WordsLabel}" />
                    </Grid>
                    <TextBlock Style="{StaticResource BodyWrapTextStyle}" Text="{x:Bind Explanation}" />
                    <ItemsControl ItemsSource="{x:Bind Reasons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid Style="{StaticResource AdvisorReasonGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource AdvisorReasonIconStyle}" Glyph="&#xE73E;" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" Text="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Requirements}" Visibility="{x:Bind helpers:Ui.VisibleIfText(Requirements)}" />
                    <Grid Style="{StaticResource IconTextGridStyle}" Visibility="{x:Bind helpers:Ui.Visible(Item.ShowSecureBootWarning)}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Style="{StaticResource WarningIconStyle}" Glyph="&#xE7BA;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Item.SecureBootWarning}" />
                    </Grid>
                    <Grid Style="{StaticResource IconTextGridStyle}" Visibility="{x:Bind helpers:Ui.Visible(Item.ShowProcessorWarning)}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Style="{StaticResource WarningIconStyle}" Glyph="&#xE7BA;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Item.ProcessorWarning}" />
                    </Grid>
                    <Button Style="{StaticResource AccentButtonStyle}" Content="{x:Bind ChooseLabel}" Command="{x:Bind ChooseCommand}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer x:Name="PageScroll" Style="{StaticResource PageScrollViewerStyle}">
        <Grid Style="{StaticResource PageContentHostStyle}">
            <StackPanel Style="{StaticResource PageContentStackStyle}">
                <StackPanel Style="{StaticResource PageHeaderStackStyle}">
                    <TextBlock x:Uid="AdvisorHeader" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Uid="AdvisorSubtitle" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.IsAlone), Mode=OneWay}">
                    <StackPanel Style="{StaticResource CardStackStyle}">
                        <TextBlock x:Uid="Alone_AdvisorJourneyTitle" Style="{StaticResource TourHeaderStyle}" />
                        <Grid Style="{StaticResource AloneStepsGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource StepNumberStyle}" Text="1" />
                            <TextBlock x:Uid="Alone_AdvisorJourney1" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource StepNumberStyle}" Text="2" />
                            <TextBlock x:Uid="Alone_AdvisorJourney2" Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource StepNumberStyle}" Text="3" />
                            <TextBlock x:Uid="Alone_AdvisorJourney3" Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource StepNumberStyle}" Text="4" />
                            <TextBlock x:Uid="Alone_AdvisorJourney4" Grid.Row="3" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                            <TextBlock Grid.Row="4" Style="{StaticResource StepNumberStyle}" Text="5" />
                            <TextBlock x:Uid="Alone_AdvisorJourney5" Grid.Row="4" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource IconTextGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;" Style="{StaticResource AdvisorReasonIconStyle}" />
                            <TextBlock x:Uid="Alone_AdvisorNothingChanged" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Questions}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.ShowQuestions), Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Style="{StaticResource GuideLessonsPanelStyle}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AdvisorQuestionViewModel">
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Style="{StaticResource CompactStackStyle}">
                                    <Grid Style="{StaticResource AdvisorQuestionHeaderGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource AdvisorQuestionTitleStyle}" Text="{x:Bind Title}" />
                                        <views:WordsButton Grid.Column="1" Words="{x:Bind Words}" Label="{x:Bind WordsLabel}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Hint, Mode=OneWay}" Visibility="{x:Bind helpers:Ui.VisibleIfText(Hint), Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource AloneHintTextStyle}" Text="{x:Bind HintAlone}" Visibility="{x:Bind helpers:Ui.Visible(ShowHintAlone), Mode=OneWay}" />
                                    <RadioButtons ItemsSource="{x:Bind Options}" SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Style="{StaticResource ButtonRowStyle}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.ShowQuestions), Mode=OneWay}">
                    <Button x:Uid="AdvisorRecommend" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RecommendCommand}" />
                    <HyperlinkButton x:Uid="AdvisorAllDistros" Command="{x:Bind ViewModel.ShowAllDistrosCommand}" />
                    <ProgressRing Style="{StaticResource StageRingStyle}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.IsLoading), Mode=OneWay}" />
                </StackPanel>

                <StackPanel x:Name="ResultsPanel" Style="{StaticResource PageContentInnerStackStyle}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.HasResult), Mode=OneWay}">
                    <Grid Style="{StaticResource TourHeaderGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="AdvisorBestTitle" Style="{StaticResource SectionTitleStyle}" />
                        <Button x:Uid="AdvisorEdit" Grid.Column="1" Command="{x:Bind ViewModel.EditAnswersCommand}" />
                    </Grid>
                    <InfoBar
                        x:Uid="AdvisorArmNote"
                        IsClosable="False"
                        Severity="Informational"
                        IsOpen="{x:Bind ViewModel.ShowArmNote, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Best}" ItemTemplate="{StaticResource AdvisorResultTemplate}" />
                    <TextBlock x:Uid="AdvisorOthersTitle" Style="{StaticResource SectionTitleStyle}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.HasAlternatives), Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Alternatives}" ItemTemplate="{StaticResource AdvisorResultTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Style="{StaticResource GuideLessonsPanelStyle}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <HyperlinkButton x:Uid="AdvisorAllDistrosResults" Command="{x:Bind ViewModel.ShowAllDistrosCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
