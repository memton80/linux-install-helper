<?xml version="1.0" encoding="utf-8"?>
<!-- Shared styles. Pages never define visual styles inline: everything lives here. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Layout tokens -->
    <Thickness x:Key="PageMargin">36,24,36,24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <x:Double x:Key="ContentMaxWidth">1000</x:Double>
    <x:Double x:Key="TitleBarHeight">48</x:Double>
    <x:Double x:Key="DistroCardWidth">300</x:Double>
    <x:Double x:Key="DistroCardHeight">196</x:Double>
    <x:Double x:Key="BadgeSize">44</x:Double>
    <CornerRadius x:Key="BadgeCornerRadius">10</CornerRadius>

    <!-- Title bar -->
    <Style x:Key="TitleBarGridStyle" TargetType="Grid">
        <Setter Property="Height" Value="{StaticResource TitleBarHeight}" />
        <Setter Property="Padding" Value="16,0,0,0" />
    </Style>

    <Style x:Key="TitleBarIconStyle" TargetType="Image">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TitleBarTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Advanced mode: the switch in the title bar and the orange frame around the window while it is on -->
    <SolidColorBrush x:Key="AdvancedModeBrush" Color="#F7630C" />

    <Style x:Key="AdvancedToggleStyle" TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- An overlay that takes no room: the pages never move when the mode is turned on. No background, so Mica shows. -->
    <Style x:Key="AdvancedFrameStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource AdvancedModeBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- Windows 10, and maximized windows: square corners. -->
    <Style x:Key="AdvancedFrameSquareStyle" TargetType="Border" BasedOn="{StaticResource AdvancedFrameStyle}">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Under the message of an error: its technical details (advanced mode) or how to show them -->
    <Style x:Key="InfoBarDetailsStackStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Pages -->
    <Style x:Key="PageRootStyle" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource PageMargin}" />
        <Setter Property="RowSpacing" Value="16" />
    </Style>

    <Style x:Key="PageScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollMode" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- The direct child of a ScrollViewer is placed horizontally by DirectManipulation, which centers it from its desired
         width, not from the width it is drawn at: a column limited by MaxWidth would then move from left to right each
         time its content changes (an expander opens, a list changes). This host fills the width of the page, so it is
         never centered, and the column below is centered by the layout, always at the same place. -->
    <Style x:Key="PageContentHostStyle" TargetType="Grid">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="PageContentStackStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="{StaticResource PageMargin}" />
        <Setter Property="Spacing" Value="16" />
        <Setter Property="MaxWidth" Value="{StaticResource ContentMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="PageHeaderStackStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="4" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyWrapTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyStrongWrapTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MonospaceTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DialogTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Cards -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="CardStackStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12" />
    </Style>

    <Style x:Key="SettingRowGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="16" />
        <Setter Property="MinHeight" Value="48" />
    </Style>

    <Style x:Key="ButtonRowStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
    </Style>

    <Style x:Key="IconTextPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
    </Style>

    <!-- An icon before a text that wraps. Never a horizontal StackPanel: it gives the text all the width it wants, so the
         text does not wrap and pushes the page past the right edge of the window. -->
    <Style x:Key="IconTextGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="8" />
    </Style>

    <Style x:Key="IconTextIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- A button at the end of a row (list of folders, programs, images, networks) -->
    <Style x:Key="RowButtonStyle" TargetType="Button">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RowToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A button next to a control that has a header above it (combo boxes) -->
    <Style x:Key="BottomAlignedButtonStyle" TargetType="Button">
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="InfoBarListPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8" />
    </Style>

    <!-- New version of the application, above the pages -->
    <Style x:Key="UpdateInfoBarStyle" TargetType="InfoBar">
        <Setter Property="Margin" Value="36,12,36,0" />
        <Setter Property="Severity" Value="Informational" />
        <Setter Property="IsClosable" Value="True" />
        <Setter Property="IsOpen" Value="False" />
    </Style>

    <!-- Distribution cards -->
    <Style x:Key="DistroCardGridStyle" TargetType="Grid">
        <Setter Property="Width" Value="{StaticResource DistroCardWidth}" />
        <Setter Property="Height" Value="{StaticResource DistroCardHeight}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="RowSpacing" Value="10" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    </Style>

    <Style x:Key="DistroCardHeaderGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="CompactStackStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="2" />
    </Style>

    <Style x:Key="DistroGridViewItemStyle" TargetType="GridViewItem">
        <Setter Property="Margin" Value="0,0,12,12" />
    </Style>

    <Style x:Key="BadgeBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource BadgeSize}" />
        <Setter Property="Height" Value="{StaticResource BadgeSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource BadgeCornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="BadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DistroNameStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="DistroDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="3" />
    </Style>

    <Style x:Key="DistroDetailsStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="WarningIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,1,0,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>

    <!-- Distribution page -->
    <Style x:Key="DistroFactGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>

    <Style x:Key="DistroFactLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="MinWidth" Value="160" />
    </Style>

    <!-- Filters -->
    <Style x:Key="FilterBarGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="RowSpacing" Value="12" />
    </Style>

    <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="WideComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- Drive lists -->
    <Style x:Key="DriveListViewStyle" TargetType="ListView">
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="MaxHeight" Value="320" />
    </Style>

    <Style x:Key="DriveItemGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="16" />
        <Setter Property="Padding" Value="4,10,4,10" />
    </Style>

    <Style x:Key="DriveIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="EmptyStateIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="EmptyStateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="EmptyStateStackStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Progress -->
    <Style x:Key="StageRowGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="Padding" Value="0,6,0,6" />
    </Style>

    <Style x:Key="StageIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="20" />
    </Style>

    <Style x:Key="StageRingStyle" TargetType="ProgressRing">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="IsActive" Value="True" />
    </Style>

    <Style x:Key="MainProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Height" Value="6" />
    </Style>

    <Style x:Key="InlineProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource MainProgressBarStyle}">
        <Setter Property="Width" Value="200" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="LogListViewStyle" TargetType="ListView">
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="MaxHeight" Value="240" />
    </Style>

    <Style x:Key="LogRowGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="8" />
        <Setter Property="Padding" Value="0,2,0,2" />
    </Style>

    <Style x:Key="LogIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <Style x:Key="LogTimeStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    </Style>

    <Style x:Key="LogMessageStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <!-- Advisor -->
    <Style x:Key="PageContentInnerStackStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12" />
    </Style>

    <Style x:Key="AdvisorNameStackStyle" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AdvisorReasonGridStyle" TargetType="Grid" BasedOn="{StaticResource IconTextGridStyle}">
        <Setter Property="Margin" Value="0,2,0,2" />
    </Style>

    <Style x:Key="AdvisorReasonIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
    </Style>

    <!-- A question and its "?" button, which stays right after the text instead of at the far end of the card. -->
    <Style x:Key="AdvisorQuestionHeaderGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="AdvisorQuestionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- "?" button that explains difficult words (WordsButton) -->
    <Style x:Key="WordsButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WordsIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="WordsPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12" />
        <Setter Property="MaxWidth" Value="360" />
    </Style>

    <Style x:Key="WordsListStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="10" />
    </Style>

    <!-- Linux tour (progress and guide pages) -->
    <Style x:Key="TourHeaderGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="TourHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TourPositionStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="TourLessonGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="16" />
        <Setter Property="MinHeight" Value="160" />
    </Style>

    <!-- Same color as the numbered marks drawn on the pictures (tools/tour-images/styles/base.css). -->
    <SolidColorBrush x:Key="TourMarkBrush" Color="#E6007A" />

    <Style x:Key="TourImageBorderStyle" TargetType="Border">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>

    <Style x:Key="TourImageStyle" TargetType="Image">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="MaxHeight" Value="300" />
    </Style>

    <Style x:Key="TourStepsPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8" />
    </Style>

    <Style x:Key="TourStepGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="10" />
    </Style>

    <Style x:Key="TourStepBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{StaticResource TourMarkBrush}" />
    </Style>

    <Style x:Key="TourStepNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TourStepTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TourIconBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource BadgeSize}" />
        <Setter Property="Height" Value="{StaticResource BadgeSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource BadgeCornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>

    <Style x:Key="TourIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="TourTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TourComparisonGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="RowSpacing" Value="6" />
    </Style>

    <Style x:Key="TourLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="ChecklistCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="ChecklistRowGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <!-- What this computer says about a step of the checklist -->
    <Style x:Key="ChecklistNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="GuideLessonsHeaderGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="GuideLessonsTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="GuideLessonsPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12" />
    </Style>

    <Style x:Key="ButtonIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="TourCommandBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12,8,12,8" />
    </Style>

    <!-- Done -->
    <Style x:Key="HeroIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="56" />
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="StepNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="Width" Value="20" />
    </Style>

    <Style x:Key="BootKeysTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Backup -->
    <Style x:Key="BackupHeroIconStyle" TargetType="FontIcon" BasedOn="{StaticResource HeroIconStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>

    <Style x:Key="FolderRowGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="Padding" Value="0,6,0,6" />
    </Style>

    <Style x:Key="FolderIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="FolderTextStackStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FolderNameStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Prepare my PC -->
    <Style x:Key="WifiRowGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="Padding" Value="0,6,0,6" />
    </Style>

    <Style x:Key="PasswordTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MonospaceTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- My programs on Linux -->
    <Style x:Key="SuggestionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Troubleshooting -->
    <Style x:Key="ProblemExpanderStyle" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- A text header, unlike a plain string, wraps when the window is narrow. -->
    <Style x:Key="ProblemTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,12,0,12" />
    </Style>

    <!-- Welcome: two large cards, one click is the answer -->
    <Style x:Key="WelcomeChoicesGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>

    <Style x:Key="WelcomeChoiceButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    </Style>

    <Style x:Key="WelcomeChoiceIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>

    <!-- What the pages add for a user on their own ("Alone" mode) -->
    <Style x:Key="AloneStepsGridStyle" TargetType="Grid" BasedOn="{StaticResource ComponentRowGridStyle}">
        <Setter Property="RowSpacing" Value="10" />
    </Style>

    <Style x:Key="AloneSubStepsStackStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="4" />
    </Style>

    <Style x:Key="AloneHintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AloneBulletIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>

    <!-- About -->
    <Style x:Key="AppIconLargeStyle" TargetType="Image">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="ComponentRowGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

</ResourceDictionary>
