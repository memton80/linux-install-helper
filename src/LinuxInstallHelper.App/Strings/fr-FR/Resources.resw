  <data name="AboutDescription.Text" xml:space="preserve">
    <value>Créez une clé USB bootable d'une distribution Linux en quelques clics : l'image officielle est téléchargée, vérifiée, puis écrite sur la clé.</value>
  </data>
  <data name="AboutLicense.Text" xml:space="preserve">
    <value>Logiciel libre et open source, licence MIT.</value>
  </data>
  <data name="AboutRepository.Content" xml:space="preserve">
    <value>Code source et signalement de bugs sur GitHub</value>
