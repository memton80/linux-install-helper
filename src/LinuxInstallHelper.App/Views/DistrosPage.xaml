<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LinuxInstallHelper.App.Views.DistrosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LinuxInstallHelper.App.ViewModels"
    xmlns:helpers="using:LinuxInstallHelper.App.Helpers"
    mc:Ignorable="d">

    <Grid Style="{StaticResource PageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Style="{StaticResource PageHeaderStackStyle}">
            <TextBlock x:Uid="DistrosHeader" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="DistrosSubtitle" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.IsAlone), Mode=OneWay}">
            <StackPanel Style="{StaticResource CardStackStyle}">
                <TextBlock x:Uid="Alone_DistrosHowTitle" Style="{StaticResource TourHeaderStyle}" />
                <Grid Style="{StaticResource AloneStepsGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource StepNumberStyle}" Text="1" />
                    <TextBlock x:Uid="Alone_DistrosHow1" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource StepNumberStyle}" Text="2" />
                    <TextBlock x:Uid="Alone_DistrosHow2" Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource StepNumberStyle}" Text="3" />
                    <TextBlock x:Uid="Alone_DistrosHow3" Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                </Grid>
                <Grid Style="{StaticResource IconTextGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;" Style="{StaticResource WarningIconStyle}" />
                    <TextBlock x:Uid="Alone_DistrosSecureBoot" Grid.Column="1" Style="{StaticResource BodyWrapTextStyle}" />
                </Grid>
                <StackPanel Style="{StaticResource ButtonRowStyle}">
                    <Button x:Uid="Alone_DistrosAdvisor" Command="{x:Bind ViewModel.OpenAdvisorCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Style="{StaticResource FilterBarGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Uid="DistrosSearch"
                VerticalAlignment="Bottom"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                x:Uid="DistrosFamily"
                Grid.Column="1"
                Style="{StaticResource FilterComboBoxStyle}"
                ItemsSource="{x:Bind ViewModel.Families}"
                SelectedIndex="{x:Bind ViewModel.FamilyIndex, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterOption">
                        <TextBlock Text="{x:Bind Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox
                x:Uid="DistrosCategory"
                Grid.Column="2"
                Style="{StaticResource FilterComboBoxStyle}"
                ItemsSource="{x:Bind ViewModel.Categories}"
                SelectedIndex="{x:Bind ViewModel.CategoryIndex, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterOption">
                        <TextBlock Text="{x:Bind Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <InfoBar
            x:Uid="DistrosOffline"
            Grid.Row="3"
            IsClosable="True"
            Severity="Informational"
            IsOpen="{x:Bind ViewModel.IsOffline, Mode=OneWay}"
            Message="{x:Bind ViewModel.CatalogStatus, Mode=OneWay}" />

        <ProgressRing
            Grid.Row="4"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind helpers:Ui.Visible(ViewModel.IsLoading), Mode=OneWay}" />

        <StackPanel
            Grid.Row="4"
            Style="{StaticResource EmptyStateStackStyle}"
            Visibility="{x:Bind helpers:Ui.Visible(ViewModel.IsEmpty), Mode=OneWay}">
            <FontIcon Glyph="&#xE721;" Style="{StaticResource EmptyStateIconStyle}" />
            <TextBlock x:Uid="DistrosEmpty" Style="{StaticResource EmptyStateTextStyle}" />
        </StackPanel>

        <GridView
            x:Name="DistrosGrid"
            Grid.Row="4"
            IsItemClickEnabled="True"
            SelectionMode="None"
            ItemClick="OnDistroClick"
            ItemContainerStyle="{StaticResource DistroGridViewItemStyle}"
            ItemsSource="{x:Bind ViewModel.Distros}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:DistroItemViewModel">
                    <Grid Style="{StaticResource DistroCardGridStyle}" AutomationProperties.Name="{x:Bind AutomationName}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Style="{StaticResource DistroCardHeaderGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource BadgeBorderStyle}" Background="{x:Bind BadgeBrush}">
                                <TextBlock Style="{StaticResource BadgeTextStyle}" Text="{x:Bind Monogram}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DistroNameStyle}" Text="{x:Bind Name}" />
                                <TextBlock Style="{StaticResource DistroDetailsStyle}" Text="{x:Bind Subtitle}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource DistroDescriptionStyle}" Text="{x:Bind Description}" />
                        <StackPanel Grid.Row="2" Style="{StaticResource CompactStackStyle}">
                            <TextBlock Style="{StaticResource DistroDetailsStyle}" Text="{x:Bind Details}" />
                            <Grid Style="{StaticResource IconTextGridStyle}" Visibility="{x:Bind helpers:Ui.Visible(ShowSecureBootWarning)}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7BA;" Style="{StaticResource WarningIconStyle}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DistroDetailsStyle}" Text="{x:Bind SecureBootWarning}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
