<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LinuxInstallHelper.App.Views.WordsButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LinuxInstallHelper.App.ViewModels"
    mc:Ignorable="d">

    <Button
        Style="{StaticResource WordsButtonStyle}"
        AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
        ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}">
        <FontIcon Style="{StaticResource WordsIconStyle}" Glyph="&#xE9CE;" />
        <Button.Flyout>
            <Flyout>
                <StackPanel Style="{StaticResource WordsPanelStyle}">
                    <TextBlock Style="{StaticResource TourHeaderStyle}" Text="{x:Bind Title}" />
                    <ItemsControl ItemsSource="{x:Bind Words, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Style="{StaticResource WordsListStyle}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExplainedWord">
                                <StackPanel Style="{StaticResource CompactStackStyle}">
                                    <TextBlock Style="{StaticResource TourLabelStyle}" Text="{x:Bind Word}" />
                                    <TextBlock Style="{StaticResource BodyWrapTextStyle}" Text="{x:Bind Meaning}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
