  <data name="TroubleshootSubtitle.Text" xml:space="preserve">
    <value>The drive does not start, or Linux does not install? Check the drive, then find your problem below.</value>
  </data>
  <data name="VerifyTitle.Text" xml:space="preserve">
    <value>Check my drive</value>
  </data>
  <data name="VerifyHelp.Text" xml:space="preserve">
    <value>Reads the drive and compares it, byte for byte, with the image it was made with. Nothing is written on the drive.</value>
  </data>
